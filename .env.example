# Anthropic API key (or run `ant auth login` and leave this unset)
ANTHROPIC_API_KEY=

# SEC requires a descriptive User-Agent: "Name email@example.com"
SEC_USER_AGENT=

# Optional: a free key from alphavantage.co enables valuation ratios (--market)
ALPHAVANTAGE_KEY=

# Only for the HTTP service (python -m fin_analyst.server): name=secret pairs,
# secrets of 16+ characters. It refuses to start without at least one.
FIN_ANALYST_API_KEYS=
