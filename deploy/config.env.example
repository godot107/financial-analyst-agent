# Copy to deploy/config.env. Nothing here is secret; secrets stay in the project .env.
PROJECT=fin-analyst
REGION=us-east-1
BUDGET_EMAIL=you@example.com
BUDGET_USD=5
# The restricted deployer profile the scripts use (created by 00_iam.sh).
AWS_PROFILE=fin-analyst
# Admin profile, only for 00_iam.sh and 99_teardown.sh --iam (sign in with: aws login --profile default).
ADMIN_PROFILE=default
